{
  "expo": {
    "name": "Shakti Yoga Kendra",
    "slug": "shakti-yoga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "shaktiyoga",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.shaktiyoga.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.shaktiyoga.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFCF8"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFCF8"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A6741"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31c0b7b9-3129-42a2-b05b-9c97ce9b338e"
      }
    },
    "owner": "shaktiyogas-team"
  }
}
