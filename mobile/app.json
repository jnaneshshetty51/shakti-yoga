{
  "expo": {
    "name": "Shakti Yoga Kendra",
    "slug": "shakti-yoga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "shaktiyoga",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.shaktiyoga.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "associatedDomains": ["applinks:shaktiyoga.in"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Shakti Yoga uses your photo library so you can set a profile picture.",
        "NSCalendarsUsageDescription": "Shakti Yoga adds your classes, therapy sessions and retreats to your device calendar when you choose to.",
        "NSFaceIDUsageDescription": "Shakti Yoga uses Face ID to unlock the app when you turn on the optional app lock."
      }
    },
    "android": {
      "package": "com.shaktiyoga.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFCF8"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.USE_BIOMETRIC",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "shaktiyoga.in", "pathPrefix": "/content" },
            { "scheme": "https", "host": "shaktiyoga.in", "pathPrefix": "/r" },
            { "scheme": "https", "host": "shaktiyoga.in", "pathPrefix": "/reset-password" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFCF8"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A6741"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shakti Yoga uses your photo library so you can set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Shakti Yoga uses Face ID to unlock the app when you turn on the optional app lock."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Shakti Yoga adds your classes, therapy sessions and retreats to your device calendar when you choose to."
        }
      ],
      "expo-sharing",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31c0b7b9-3129-42a2-b05b-9c97ce9b338e"
      }
    },
    "owner": "shaktiyogas-team"
  }
}
