generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  SUPER_ADMIN
  STAFF_ADMIN
  TEACHER
  MEMBER_EVERYDAY
  MEMBER_THERAPY
  TRIAL
  VISITOR
}

enum PlanType {
  EVERYDAY_YOGA
  YOGA_THERAPY
  TRIAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED
  TRIAL
  EXPIRED
}

enum BookingType {
  THERAPY_SESSION
  CONSULTATION
  SPECIAL_SESSION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  REFERRAL
  SOCIAL_MEDIA
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  CONVERTED
  LOST
}

enum ProgramLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum ProgramStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// Models

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role      @default(VISITOR)
  phone        String?
  country      String?
  timezone     String    @default("IST")
  avatarUrl    String?
  credits      Int       @default(0) // 1:1 therapy session credits
  trialStartedAt DateTime? // set once, the first time the user activates a free trial
  tokenVersion Int       @default(0) // bump to invalidate all outstanding sessions (e.g. on password reset)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLogin    DateTime?

  // Relations
  profile      UserProfile?
  subscription Subscription?
  bookings     Booking[]
  stories      Story[]
  payments     Payment[]

  // For Teachers
  classesTaught  ClassBatch[]
  sessionsTaught Booking[]    @relation("TeacherBookings")
  availability   TeacherAvailability[] @relation("TeacherAvailability")

  // For Students
  classAttendance ClassAttendance[]

  // For Staff/Admins managing leads
  assignedLeads Lead[]

  passwordResetTokens PasswordResetToken[]
}

model UserProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals             String?
  medicalHistory    String?
  communicationPref String? // Email, WhatsApp, Phone
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id])
  planType          PlanType
  amount            Float
  currency          String             @default("INR")
  status            SubscriptionStatus @default(ACTIVE)
  startDate         DateTime           @default(now())
  renewalDate       DateTime
  billingProviderId String? // Razorpay subscription id (sub_xxx) for recurring plans
  recurring         Boolean            @default(false)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Payment {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id])
  planType               PlanType
  amount                 Float // major currency units (e.g. rupees)
  currency               String        @default("INR")
  status                 PaymentStatus @default(CREATED)
  provider               String        @default("razorpay")
  providerOrderId        String?       @unique // one-time checkout order
  providerSubscriptionId String? // set for recurring subscription charges
  providerPaymentId      String?       @unique
  providerSignature      String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model ClassBatch {
  id          String   @id @default(cuid())
  name        String
  planType    PlanType
  daysOfWeek  String[] // ["Mon", "Wed", "Fri"]
  timeSlot    String // "06:00 AM"
  durationMin Int      @default(60) // class length, used for the join window
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  active      Boolean  @default(true)
  meetingLink String? // default Google Meet URL for every instance of this batch

  instances ClassInstance[]
}

model ClassInstance {
  id              String     @id @default(cuid())
  batchId         String
  batch           ClassBatch @relation(fields: [batchId], references: [id])
  date            DateTime // class start, stored in UTC
  status          String // Scheduled, Completed, Cancelled
  recordingUrl    String?
  meetingLink     String? // overrides batch.meetingLink for this one occurrence
  attendanceCount Int        @default(0)

  attendees ClassAttendance[]

  @@unique([batchId, date])
}

model ClassAttendance {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  classInstanceId String
  classInstance   ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
  joinedAt        DateTime      @default(now())

  @@unique([userId, classInstanceId])
}

// NOTE: migration 20260906190000 adds a PARTIAL unique index
//   UNIQUE (teacherId, date) WHERE status IN ('PENDING','CONFIRMED')
// Prisma can't express this in-schema, so `migrate dev` will report it as
// drift — keep the index, don't let a reset drop it.
model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  teacherId   String
  teacher     User          @relation("TeacherBookings", fields: [teacherId], references: [id])
  type        BookingType
  status      BookingStatus @default(PENDING)
  date        DateTime
  notes       String? // Session notes by teacher
  meetingLink String?
  createdAt   DateTime      @default(now())
}

model Story {
  id         String        @id @default(cuid())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  authorName String // Fallback if no user
  location   String?
  planType   String?
  quote      String
  content    String? // Longer testimonial
  rating     Int           @default(5)
  status     ContentStatus @default(DRAFT)
  imageUrl   String?
  createdAt  DateTime      @default(now())
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String?
  content         String // Markdown or HTML
  category        String
  author          String
  publishedAt     DateTime?
  status          ContentStatus @default(DRAFT)
  imageUrl        String?
  featuredImage   String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([category])
}

model WhatsAppGroup {
  id            String  @id @default(cuid())
  name          String
  link          String
  role          Role // Which role this group is for
  pinnedMessage String?
  active        Boolean @default(true)
}

model Lead {
  id   String @id @default(cuid())
  name String
  email String
  phone   String?
  country String?
  source LeadSource @default(WEBSITE)
  status LeadStatus @default(NEW)
  notes   String?

  // Trial info
  trialRequestedAt DateTime?
  trialDate        DateTime?
  trialAttended    Boolean   @default(false)

  // Conversion tracking
  convertedToUserId String?
  convertedAt       DateTime?

  // Assignment
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]

  @@index([email])
  @@index([status])
}

model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type        String // CALL, EMAIL, WHATSAPP, NOTE, STATUS_CHANGE
  content     String
  performedBy String?

  createdAt DateTime @default(now())
}

model Program {
  id            String        @id @default(cuid())
  title         String
  description   String
  duration      String // e.g., "4 Weeks"
  level         ProgramLevel  @default(ALL_LEVELS)
  status        ProgramStatus @default(DRAFT)
  price         Float         @default(0)
  thumbnail     String? // URL to image
  enrolledCount Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model FAQ {
  id        String        @id @default(cuid())
  question  String
  answer    String
  category  String        @default("General") // General, Pricing, Classes, Technical
  sortOrder Int           @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, category])
}

model Plan {
  id          String        @id @default(cuid())
  name        String
  planType    PlanType // EVERYDAY_YOGA, YOGA_THERAPY, TRIAL
  price       Float
  currency    String        @default("INR")
  period      String // "month", "week", "once"
  features    String[] // Array of feature strings
  description String?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planType, status])
}

model SiteStats {
  id        String   @id @default(cuid())
  statKey   String   @unique // e.g., "totalStudents", "countriesCount"
  statValue String
  category  String   @default("general") // general, social_proof, performance
  updatedAt DateTime @updatedAt
}

model WhyUsBenefit {
  id          String        @id @default(cuid())
  icon        String // Emoji or icon class
  title       String
  description String
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String // PAGE_VIEW, SIGNUP, SUBSCRIPTION, BOOKING, etc.
  userId    String?
  metadata  Json? // Additional event data
  timestamp DateTime @default(now())

  @@index([eventType])
  @@index([timestamp])
  @@index([userId])
}

model RevenueRecord {
  id         String   @id @default(cuid())
  userId     String
  amount     Float
  currency   String   @default("USD")
  planType   PlanType
  provider   String? // razorpay, stripe
  providerId String?
  status     String   @default("SUCCESS") // SUCCESS, FAILED, REFUNDED
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String // e.g. "user.role.change", "subscription.update", "class.cancel"
  entity     String // "User", "Subscription", "ClassInstance", ...
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}

model TeacherAvailability {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     User     @relation("TeacherAvailability", fields: [teacherId], references: [id], onDelete: Cascade)
  // Either a recurring weekday rule (dayOfWeek set, date null) or a one-off (date set).
  dayOfWeek   String? // "Mon".."Sun"
  date        DateTime? // specific day (UTC midnight IST)
  startTime   String // "09:00" 24h IST
  endTime     String // "17:00" 24h IST
  slotMinutes Int      @default(45)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([teacherId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
