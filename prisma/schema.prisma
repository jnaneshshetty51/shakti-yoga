generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  SUPER_ADMIN
  STAFF_ADMIN
  TEACHER
  MEMBER_EVERYDAY
  MEMBER_THERAPY
  TRIAL
  VISITOR
}

enum PlanType {
  EVERYDAY_YOGA
  YOGA_THERAPY
  TRIAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED
  TRIAL
  EXPIRED
}

enum BookingType {
  THERAPY_SESSION
  CONSULTATION
  SPECIAL_SESSION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

// Models

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role      @default(VISITOR)
  phone        String?
  country      String?
  timezone     String    @default("IST")
  avatarUrl    String?
  credits      Int       @default(0) // 1:1 therapy session credits
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLogin    DateTime?

  // Relations
  profile      UserProfile?
  subscription Subscription?
  bookings     Booking[]
  stories      Story[]
  payments     Payment[]

  // For Teachers
  classesTaught     ClassBatch[]
  sessionsTaught    Booking[]    @relation("TeacherBookings")
  liveClassesTaught LiveClass[]  @relation("TeacherLiveClasses")

  // For Students
  liveClassParticipation LiveClassParticipant[]
}

model UserProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals             String?
  medicalHistory    String?
  communicationPref String? // Email, WhatsApp, Phone
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id])
  planType          PlanType
  amount            Float
  currency          String             @default("INR")
  status            SubscriptionStatus @default(ACTIVE)
  startDate         DateTime           @default(now())
  renewalDate       DateTime
  billingProviderId String? // Razorpay customer/subscription id
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  planType          PlanType
  amount            Float // major currency units (e.g. rupees)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  provider          String        @default("razorpay")
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  providerSignature String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model ClassBatch {
  id          String   @id @default(cuid())
  name        String
  planType    PlanType
  daysOfWeek  String[] // ["Mon", "Wed", "Fri"]
  timeSlot    String // "06:00 AM"
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  active      Boolean  @default(true)
  meetingLink String?

  instances ClassInstance[]
}

model ClassInstance {
  id              String     @id @default(cuid())
  batchId         String
  batch           ClassBatch @relation(fields: [batchId], references: [id])
  date            DateTime
  status          String // Scheduled, Completed, Cancelled
  recordingUrl    String?
  attendanceCount Int        @default(0)
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  teacherId   String
  teacher     User          @relation("TeacherBookings", fields: [teacherId], references: [id])
  type        BookingType
  status      BookingStatus @default(PENDING)
  date        DateTime
  notes       String? // Session notes by teacher
  meetingLink String?
  createdAt   DateTime      @default(now())
}

model Story {
  id         String        @id @default(cuid())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  authorName String // Fallback if no user
  location   String?
  planType   String?
  quote      String
  content    String? // Longer testimonial
  rating     Int           @default(5)
  status     ContentStatus @default(DRAFT)
  imageUrl   String?
  createdAt  DateTime      @default(now())
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?
  content     String // Markdown or HTML
  category    String
  author      String
  publishedAt DateTime?
  status      ContentStatus @default(DRAFT)
  imageUrl    String?
  createdAt   DateTime      @default(now())
}

model WhatsAppGroup {
  id            String  @id @default(cuid())
  name          String
  link          String
  role          Role // Which role this group is for
  pinnedMessage String?
  active        Boolean @default(true)
}

model LiveClass {
  id          String  @id @default(cuid())
  title       String
  description String?
  teacherId   String
  teacher     User    @relation("TeacherLiveClasses", fields: [teacherId], references: [id])

  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?

  roomUrl String? // Daily.co room URL
  roomId  String? // Daily.co room ID

  maxParticipants Int             @default(50)
  status          LiveClassStatus @default(SCHEDULED)

  participants LiveClassParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LiveClassParticipant {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  liveClassId String
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  joinedAt DateTime?
  leftAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, liveClassId])
}
