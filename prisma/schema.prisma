generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  SUPER_ADMIN
  STAFF_ADMIN
  TEACHER
  MEMBER_EVERYDAY
  MEMBER_STARTER
  MEMBER_THERAPY
  TRIAL
  VISITOR
}

enum PlanType {
  EVERYDAY_YOGA
  YOGA_THERAPY
  STARTER
  FAMILY
  TRIAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED
  TRIAL
  EXPIRED
}

enum AttendanceStatus {
  CHECKED_IN // self-reported by tapping Join — not yet counted against the cycle
  PRESENT // teacher-confirmed — consumes one session credit on a capped plan
  ABSENT // teacher-marked no-show — no charge
}

enum SessionCreditReason {
  CYCLE_GRANT // +N when a capped plan is activated or renewed (no rollover)
  CLASS_ATTENDED // -1 when a teacher confirms a member Present
  CLASS_REVERSED // +1 when a confirmed Present is later corrected to Absent
  PURCHASE // +N from buying extra sessions (EY-12)
  ADMIN_ADJUST // manual correction by an admin
}

enum BookingType {
  THERAPY_SESSION
  CONSULTATION
  SPECIAL_SESSION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  REEL
  POST
  ANNOUNCEMENT
}

enum ContentCategory {
  YOGA
  BREATHING
  MINDFULNESS
  MOBILITY
  SLEEP
  STRENGTH
  WELLNESS
  BEGINNERS
  PHILOSOPHY
  STUDIO
  COMMUNITY
}

enum PracticeLevel {
  BEGINNER
  INTERMEDIATE
  ALL_LEVELS
}

enum ChallengeGoal {
  CLASSES
  PRACTICES
  PRACTICE_MINUTES
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  REFERRAL
  SOCIAL_MEDIA
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  CONVERTED
  LOST
}

enum ReferralStatus {
  PENDING // referee signed up, hasn't made a qualifying payment yet
  SUCCESSFUL // qualifying payment made, referrer credited
  EXPIRED // referee didn't convert within the validity window — no reward
  REVERSED // reward clawed back (refund / abuse) by an admin
}

enum TherapyIntakeStatus {
  DRAFT // being filled in, not yet submitted
  SUBMITTED // submitted, editable until a therapist starts reviewing
  UNDER_REVIEW // a therapist has opened it — locked from further edits
  RECOMMENDED
  RECOMMENDED_WITH_CONDITIONS
  NOT_RECOMMENDED // internal only — never surfaced verbatim to the applicant
}

// Models

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role      @default(VISITOR)
  active       Boolean   @default(true) // false = admin-deactivated; blocked at sign-in
  phone        String?
  country      String?
  timezone     String    @default("IST")
  avatarUrl    String?
  credits      Int       @default(0) // 1:1 therapy session credits
  trialStartedAt DateTime? // set once, the first time the user activates a free trial
  tokenVersion Int       @default(0) // bump to invalidate all outstanding sessions (e.g. on password reset)
  referralCode      String?  @unique // this user's own shareable code
  referralCreditBalance Float @default(0) // ₹ wallet, redeemable at checkout (any plan, any renewal)
  adminDepartment AdminDepartment? // null = full admin access; set = scoped to one admin department
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLogin    DateTime?

  // Relations
  profile      UserProfile?
  staffProfile StaffProfile?
  subscription Subscription?
  bookings     Booking[]
  stories      Story[]
  payments     Payment[]

  therapyIntake          TherapyIntake?
  therapyIntakesReviewed TherapyIntake[] @relation("TherapyIntakeReviewer")

  // For Teachers
  classesTaught  ClassBatch[]
  sessionsTaught Booking[]    @relation("TeacherBookings")
  availability   TeacherAvailability[] @relation("TeacherAvailability")

  // For Students
  classAttendance      ClassAttendance[]
  attendanceConfirmed  ClassAttendance[]     @relation("AttendanceConfirmedBy")
  sessionCreditEntries SessionCreditEntry[]

  // For Staff/Admins managing leads
  assignedLeads Lead[]

  passwordResetTokens PasswordResetToken[]
  webHandoffTokens WebHandoffToken[]

  contentInteractions ContentInteraction[]
  contentComments     ContentComment[]

  practiceCompletions   PracticeCompletion[]
  challengeParticipation ChallengeParticipant[]
  achievements          UserAchievement[]
  communityPosts        CommunityPost[]
  communityComments     CommunityComment[]
  communityLikes        CommunityInteraction[]

  referralsSent    Referral[] @relation("ReferralsSent")
  referralReceived Referral?  @relation("ReferralReceived")

  pushTokens PushToken[]

  certificates         Certificate[]
  certificatesApproved Certificate[] @relation("CertificateApprover")

  assignedCorporateLeads CorporateLead[]

  supportConversations         SupportConversation[]
  supportConversationsAssigned SupportConversation[] @relation("SupportAssignee")
  supportMessagesSent          SupportMessage[]

  invoices             Invoice[]
  therapyMeasurements  TherapyMeasurement[]
  measurementsRecorded TherapyMeasurement[] @relation("MeasurementRecorder")
  patientUpdates       PatientUpdate[]
  patientUpdatesReviewed PatientUpdate[]    @relation("PatientUpdateReviewer")
}

/// One redeemed referral. Created (PENDING) when someone signs up with a code;
/// advances to SUCCESSFUL on that person's first qualifying paid membership — the
/// point the referrer's ₹ reward is credited — or EXPIRED if that never happens
/// inside the validity window. One row per referred person.
model Referral {
  id         String         @id @default(cuid())
  referrerId String
  referrer   User           @relation("ReferralsSent", fields: [referrerId], references: [id], onDelete: Cascade)
  code       String
  refereeId  String         @unique
  referee    User           @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  status     ReferralStatus @default(PENDING)

  // ₹ snapshots — what was actually granted, independent of later setting changes.
  rewardAmount          Float @default(0) // credited to the referrer
  refereeDiscountAmount Float @default(0) // taken off the referee's first payment

  expiresAt   DateTime // referrer's reward lapses if the referee hasn't paid by this date
  convertedAt DateTime?
  rewardedAt  DateTime?
  reversedAt  DateTime?
  flagged     Boolean   @default(false) // admin-marked for manual review
  createdAt   DateTime  @default(now())

  @@index([referrerId])
  @@index([status])
  @@index([expiresAt])
}

model UserProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals             String?
  medicalHistory    String?
  communicationPref String? // Email, WhatsApp, Phone
}

/// Public-facing profile for teachers / staff — the person's bio, title, photo
/// (photo lives on User.avatarUrl), specialties, and where they show on the site.
model StaffProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String? // "Senior Yoga Therapist"
  bio             String? // longer description
  specialties     String[] // ["Prenatal", "Back pain", "Pranayama"]
  yearsExperience Int?
  displayOrder    Int      @default(0)
  publicVisible   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id])
  planType          PlanType
  planKey           String? // e.g. 'everyday_annual' — the exact ladder rung (lib/pricing)
  interval          String             @default("monthly") // monthly | annual | trial
  amount            Float
  currency          String             @default("INR")
  status            SubscriptionStatus @default(ACTIVE)
  startDate         DateTime           @default(now())
  renewalDate       DateTime
  provider          String             @default("razorpay") // razorpay | apple | google
  store             String? // 'app_store' | 'play_store' — set for RevenueCat-managed subs
  billingProviderId String? // Razorpay sub id (sub_xxx), or RevenueCat original_transaction_id
  recurring         Boolean            @default(false)
  familyOwnerId     String? // set on the invited seat of a Family plan → points at the payer
  familyInviteCode  String?            @unique // the owner's shareable seat code
  pendingPlanKey    String? // a scheduled downgrade — applied at the next renewal
  pausedAt          DateTime? // set when the member pauses; access still runs to renewalDate
  currentCycleStart DateTime? // start of the active session-credit window (capped plans only; null = uncapped)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Payment {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id])
  planType               PlanType
  planKey                String? // exact ladder rung (lib/pricing) — distinguishes monthly vs annual
  amount                 Float // major currency units (e.g. rupees)
  currency               String        @default("INR")
  status                 PaymentStatus @default(CREATED)
  provider               String        @default("razorpay")
  providerOrderId        String?       @unique // one-time checkout order
  providerSubscriptionId String? // set for recurring subscription charges
  providerPaymentId      String?       @unique
  providerSignature      String?
  creditApplied          Float         @default(0) // ₹ of the payer's own referral-credit wallet spent on this payment
  refereeDiscountApplied Float         @default(0) // ₹ one-time new-referee discount spent on this payment
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model ClassBatch {
  id          String   @id @default(cuid())
  name        String
  planType    PlanType
  daysOfWeek  String[] // ["Mon", "Wed", "Fri"]
  timeSlot    String // "06:00 AM"
  durationMin Int      @default(60) // class length, used for the join window
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  active      Boolean  @default(true)
  capacity    Int? // max attendees per instance; null = uncapped
  meetingLink String? // default Google Meet URL for every instance of this batch

  instances ClassInstance[]
}

model ClassInstance {
  id              String     @id @default(cuid())
  batchId         String
  batch           ClassBatch @relation(fields: [batchId], references: [id])
  date            DateTime // class start, stored in UTC
  status          String // Scheduled, Completed, Cancelled
  recordingUrl    String?
  meetingLink     String? // overrides batch.meetingLink for this one occurrence
  capacity        Int? // overrides batch.capacity for this one occurrence
  attendanceCount Int        @default(0)

  attendees ClassAttendance[]

  @@unique([batchId, date])
}

model ClassAttendance {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  classInstanceId String
  classInstance   ClassInstance    @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
  joinedAt        DateTime         @default(now())
  status          AttendanceStatus @default(CHECKED_IN)
  confirmedAt     DateTime? // when a teacher finalised this member's attendance
  confirmedById   String?
  confirmedBy     User?            @relation("AttendanceConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  addedByTeacher  Boolean          @default(false) // teacher created this row (member never tapped Join)

  creditEntries SessionCreditEntry[]

  @@unique([userId, classInstanceId])
  @@index([classInstanceId, status])
}

/// Append-only ledger of session-credit movements for capped group-class plans
/// (Everyday Yoga / Family, monthly). The balance for the active cycle is
/// sum(delta) over entries whose cycleStart matches Subscription.currentCycleStart —
/// a renewal opens a new cycle, so unused credits simply stop counting (no
/// rollover). Uncapped plans (annual Everyday/Family, Starter, Yoga Therapy)
/// never get entries.
model SessionCreditEntry {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta             Int // +20 grant, -1 attended, +1 reversed, …
  reason            SessionCreditReason
  cycleStart        DateTime // the Subscription cycle window this entry belongs to
  classAttendanceId String?
  classAttendance   ClassAttendance?    @relation(fields: [classAttendanceId], references: [id], onDelete: SetNull)
  note              String?
  createdById       String? // teacher/admin behind a manual or confirmation-driven entry
  createdAt         DateTime            @default(now())

  @@index([userId, cycleStart])
  @@index([classAttendanceId])
}

// NOTE: migration 20260906190000 adds a PARTIAL unique index
//   UNIQUE (teacherId, date) WHERE status IN ('PENDING','CONFIRMED')
// Prisma can't express this in-schema, so `migrate dev` will report it as
// drift — keep the index, don't let a reset drop it.
model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  teacherId   String
  teacher     User          @relation("TeacherBookings", fields: [teacherId], references: [id])
  type        BookingType
  status      BookingStatus @default(PENDING)
  date        DateTime
  notes       String? // Session notes by teacher
  meetingLink String?
  createdAt   DateTime      @default(now())
}

/// A Yoga Therapy assessment/intake. One per user (re-editable while DRAFT/SUBMITTED,
/// locked once a therapist starts reviewing it).
model TherapyIntake {
  id     String              @id @default(cuid())
  userId String              @unique
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status TherapyIntakeStatus @default(DRAFT)

  // Personal details
  fullName String?
  age      Int?
  gender   String?
  heightCm Float?
  weightKg Float?

  // Health concern
  primaryConcern     String?
  concernDuration    String? // e.g. "3 months", "2 years"
  concernDescription String?

  // Medical history
  injuriesSurgeries String?
  medicalConditions String?
  medications       String?
  familyHistory     String?
  priorYogaTherapy  String?

  // Consent + emergency contact
  consentGiven          Boolean @default(false)
  emergencyContactName  String?
  emergencyContactPhone String?

  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("TherapyIntakeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Story {
  id         String        @id @default(cuid())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  authorName String // Fallback if no user
  location   String?
  planType   String?
  quote      String
  content    String? // Longer testimonial
  rating     Int           @default(5)
  status     ContentStatus @default(DRAFT)
  imageUrl   String?
  createdAt  DateTime      @default(now())
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String?
  content         String // Markdown or HTML
  category        String
  author          String
  publishedAt     DateTime?
  status          ContentStatus @default(DRAFT)
  imageUrl        String?
  featuredImage   String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // "Don't let an article be a dead end" — pair it with practice.
  ctaType             String? // same set as Content, minus 'open_blog'
  ctaLabel            String?
  relatedClassBatchId String? // loose pointer to a ClassBatch (resolved at read)
  relatedPracticeId   String?
  relatedPractice     Practice? @relation("PracticeRelatedBlog", fields: [relatedPracticeId], references: [id], onDelete: SetNull)

  relatedContent  Content[]     @relation("BlogRelatedContent")

  @@index([status])
  @@index([category])
}

/// Feed-native content for the member app: Instagram Reels (link + thumbnail),
/// image/text Posts, and studio Announcements. Blogs stay in BlogPost; the app's
/// /api/content/feed merges both into one stream. Every item can carry a CTA
/// that routes the member back into practice (next class, therapy, an article).
model Content {
  id       String          @id @default(cuid())
  type     ContentType
  status   ContentStatus   @default(DRAFT)
  category ContentCategory  @default(YOGA)

  title   String
  body    String? // POST / ANNOUNCEMENT copy (markdown-lite). null for REEL.
  caption String? // REEL one-liner under the thumbnail

  instagramUrl String? // https://www.instagram.com/reel/XXXX/ — optional "View on Instagram" link
  imageUrl     String? // REEL thumbnail / POST + ANNOUNCEMENT hero (as /api/media/<key>)
  videoUrl     String? // REEL self-hosted clip (as /api/media/<key>) — plays natively in the app
  mediaUrls    String[] @default([]) // POST carousel (Phase 2)

  ctaType          String? // 'join_next_class' | 'view_classes' | 'book_therapy' | 'open_blog' | 'open_practice' | 'none'
  ctaLabel         String?
  relatedBlogId    String?
  relatedBlog      BlogPost? @relation("BlogRelatedContent", fields: [relatedBlogId], references: [id], onDelete: SetNull)
  relatedPracticeId String?
  relatedPractice   Practice? @relation("PracticeRelatedContent", fields: [relatedPracticeId], references: [id], onDelete: SetNull)

  author String @default("Shakti Yoga")
  tags   String[] @default([])

  publishedAt DateTime?
  scheduledAt DateTime? // future -> publish-scheduled cron flips it to PUBLISHED (Phase 3)
  expiresAt   DateTime? // after this the item drops out of the feed/home
  pinned      Boolean   @default(false)
  important   Boolean   @default(false) // ANNOUNCEMENT: highlighted + always-on-top
  audience    String[]  @default([]) // plan-tier keys it targets; empty = everyone

  likeCount    Int @default(0)
  saveCount    Int @default(0)
  viewCount    Int @default(0)
  commentCount Int @default(0)

  // Push: when true, members with the app get one notification the first time
  // this item is published. `notifiedAt` is the idempotency claim.
  notifyOnPublish Boolean   @default(false)
  notifiedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions ContentInteraction[]
  comments     ContentComment[]

  @@index([status, type, publishedAt])
  @@index([status, category])
  @@index([scheduledAt])
}

/// A member's like / save on a Content item. One row per (user, content, kind).
model ContentInteraction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  kind      String // 'like' | 'save'
  createdAt DateTime @default(now())

  @@unique([userId, contentId, kind])
  @@index([userId, kind])
  @@index([contentId, kind])
}

/// A member comment on a Content item. `hidden` is set by admin moderation;
/// hidden comments still count against the author but never render for members.
model ContentComment {
  id          String   @id @default(cuid())
  contentId   String
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body        String
  hidden      Boolean  @default(false)
  reportCount Int      @default(0)
  createdAt   DateTime @default(now())

  reports CommentReport[]

  @@index([contentId, hidden, createdAt])
  @@index([reportCount])
}

/// One member's report of a comment. Bumps ContentComment.reportCount.
model CommentReport {
  id        String         @id @default(cuid())
  commentId String
  comment   ContentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  reason    String?
  createdAt DateTime       @default(now())

  @@unique([commentId, userId])
}

/// A guided practice — a short at-home sequence. Links out to a video (Instagram
/// / YouTube) like a reel; the app never hosts video. `steps` is a markdown list.
model Practice {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String? // markdown-lite intro
  steps        String? // markdown list of cues
  category     ContentCategory @default(YOGA)
  level        PracticeLevel @default(ALL_LEVELS)
  durationMin  Int           @default(10)
  videoUrl     String? // Instagram / YouTube link, opened externally
  thumbnailUrl String? // /api/media/<key>
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  completions    PracticeCompletion[]
  relatedContent Content[]  @relation("PracticeRelatedContent")
  relatedBlogs   BlogPost[] @relation("PracticeRelatedBlog")

  @@index([status, category])
}

/// One member marking a practice done. `minutes` snapshots the duration so
/// progress totals survive a later edit to Practice.durationMin.
model PracticeCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  minutes     Int
  completedAt DateTime @default(now())

  @@index([userId, completedAt])
  @@index([practiceId])
}

/// A time-boxed goal members opt into ("30 classes in 30 days"). Progress is
/// derived from attendance / practice completions inside [startDate, endDate].
model Challenge {
  id          String        @id @default(cuid())
  title       String
  description String?
  goalType    ChallengeGoal @default(CLASSES)
  goalTarget  Int           @default(30)
  startDate   DateTime
  endDate     DateTime
  imageUrl    String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  participants ChallengeParticipant[]

  @@index([status, endDate])
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())
  completedAt DateTime?

  @@unique([challengeId, userId])
  @@index([userId])
}

/// An earned badge. Definitions live in code (src/lib/achievements.ts); this
/// table is just the award ledger. One row per (user, key).
model UserAchievement {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key      String
  earnedAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

/// A member-authored community post. Moderated the same way as content comments
/// (`hidden` + `reportCount`, auto-hide at a threshold).
model CommunityPost {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body         String
  imageUrl     String?
  hidden       Boolean  @default(false)
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  reportCount  Int      @default(0)
  createdAt    DateTime @default(now())

  comments     CommunityComment[]
  interactions CommunityInteraction[]
  reports      CommunityReport[]

  @@index([hidden, createdAt])
  @@index([reportCount])
}

model CommunityComment {
  id          String        @id @default(cuid())
  postId      String
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body        String
  hidden      Boolean       @default(false)
  reportCount Int           @default(0)
  createdAt   DateTime      @default(now())

  reports CommunityReport[]

  @@index([postId, hidden, createdAt])
  @@index([reportCount])
}

/// A like on a community post. One row per (user, post).
model CommunityInteraction {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

/// A report against a community post or one of its comments.
model CommunityReport {
  id        String            @id @default(cuid())
  postId    String?
  post      CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  reason    String?
  createdAt DateTime          @default(now())

  @@index([postId])
  @@index([commentId])
}

model WhatsAppGroup {
  id            String  @id @default(cuid())
  name          String
  link          String
  role          Role // Which role this group is for
  pinnedMessage String?
  active        Boolean @default(true)
}

model Lead {
  id   String @id @default(cuid())
  name String
  email String
  phone   String?
  country String?
  source LeadSource @default(WEBSITE)
  status LeadStatus @default(NEW)
  notes   String?

  // Trial info
  trialRequestedAt DateTime?
  trialDate        DateTime?
  trialAttended    Boolean   @default(false)

  // Conversion tracking
  convertedToUserId String?
  convertedAt       DateTime?

  // Assignment
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]

  @@index([email])
  @@index([status])
}

model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type        String // CALL, EMAIL, WHATSAPP, NOTE, STATUS_CHANGE
  content     String
  performedBy String?

  createdAt DateTime @default(now())
}

model FAQ {
  id        String        @id @default(cuid())
  question  String
  answer    String
  category  String        @default("General") // General, Pricing, Classes, Technical
  sortOrder Int           @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, category])
}

model Plan {
  id          String        @id @default(cuid())
  name        String
  planType    PlanType // EVERYDAY_YOGA, YOGA_THERAPY, TRIAL
  price       Float
  currency    String        @default("INR")
  period      String // "month", "week", "once"
  features    String[] // Array of feature strings
  description String?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planType, status])
}

model SiteStats {
  id        String   @id @default(cuid())
  statKey   String   @unique // e.g., "totalStudents", "countriesCount"
  statValue String
  category  String   @default("general") // general, social_proof, performance
  updatedAt DateTime @updatedAt
}

model WhyUsBenefit {
  id          String        @id @default(cuid())
  icon        String // Emoji or icon class
  title       String
  description String
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String // PAGE_VIEW, SIGNUP, SUBSCRIPTION, BOOKING, etc.
  userId    String?
  metadata  Json? // Additional event data
  timestamp DateTime @default(now())

  @@index([eventType])
  @@index([timestamp])
  @@index([userId])
}

model RevenueRecord {
  id         String   @id @default(cuid())
  userId     String
  amount     Float
  currency   String   @default("USD")
  planType   PlanType
  provider   String? // razorpay, stripe
  providerId String?
  status     String   @default("SUCCESS") // SUCCESS, FAILED, REFUNDED
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// One row per webhook event we have already processed. Handlers insert before
/// doing work and skip on a unique-constraint hit, so a redelivered event is a
/// no-op (RevenueCat has no other idempotency key; Razorpay leans on Payment).
model ProcessedWebhookEvent {
  id        String   @id @default(cuid())
  provider  String // 'revenuecat' | 'razorpay'
  eventId   String
  eventType String?
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String // e.g. "user.role.change", "subscription.update", "class.cancel"
  entity     String // "User", "Subscription", "ClassInstance", ...
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}

model TeacherAvailability {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     User     @relation("TeacherAvailability", fields: [teacherId], references: [id], onDelete: Cascade)
  // Either a recurring weekday rule (dayOfWeek set, date null) or a one-off (date set).
  dayOfWeek   String? // "Mon".."Sun"
  date        DateTime? // specific day (UTC midnight IST)
  startTime   String // "09:00" 24h IST
  endTime     String // "17:00" 24h IST
  slotMinutes Int      @default(45)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([teacherId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One-time handoff from the mobile app's bearer-token session into a web
/// cookie session, so "Change plan" / "Resume" opening the web checkout in
/// the system browser doesn't force a second login — the web session has no
/// idea about the app's bearer token otherwise. Single-use, short-lived.
model WebHandoffToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Expo push notification token for a member's device (native app).
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // "ios" | "android"
  deviceName String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

enum AdminDepartment {
  CONTENT
  SUPPORT
  TRAINER
  THERAPIST
}

enum CertificateStatus {
  PENDING
  APPROVED
  REVOKED
}

/// An earned/issued certificate (e.g. challenge completion). Auto-created as
/// PENDING when a predefined criterion is met (see updateChallengeProgress in
/// src/lib/challenges.ts); Founder/Admin can also issue one manually. Requires
/// Founder/Admin approval before it's visible to the member or verifiable.
model Certificate {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  reason           String?
  status           CertificateStatus @default(PENDING)
  verificationCode String            @unique @default(cuid())
  issuedAt         DateTime          @default(now())
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?             @relation("CertificateApprover", fields: [approvedById], references: [id])
  sourceType       String? // e.g. "Challenge"
  sourceId         String?

  @@index([userId])
  @@index([status])
}

enum CorporateLeadStatus {
  NEW
  CONTACTED
  DISCUSSION
  PROPOSAL
  CONFIRMED
  PAYMENT
  COMPLETED
  LOST
}

/// A B2B enquiry — distinct from the consumer `Lead` pipeline; corporate deals
/// carry company-shaped fields and a longer negotiation pipeline.
model CorporateLead {
  id              String              @id @default(cuid())
  companyName     String
  contactName     String
  contactEmail    String
  contactPhone    String?
  employeeCount   Int?
  requirement     String?
  programInterest String?
  message         String?
  status          CorporateLeadStatus @default(NEW)
  dealValue       Float?
  notes           String?
  assignedToId    String?
  assignedTo      User?               @relation(fields: [assignedToId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  activities CorporateLeadActivity[]

  @@index([status])
}

model CorporateLeadActivity {
  id              String        @id @default(cuid())
  corporateLeadId String
  corporateLead   CorporateLead @relation(fields: [corporateLeadId], references: [id], onDelete: Cascade)
  type            String // CALL, EMAIL, WHATSAPP, NOTE, STATUS_CHANGE
  content         String
  performedBy     String?
  createdAt       DateTime      @default(now())

  @@index([corporateLeadId])
}

enum RetreatKind {
  RETREAT
  WORKSHOP
  EVENT
}

enum RetreatStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RetreatEnquiryStatus {
  NEW
  CONTACTED
  CONFIRMED
  PAID
  CANCELLED
}

/// A retreat, workshop, or one-off event — same shape, discriminated by `kind`
/// per the spec (both flow: enquiry -> admin confirmation -> manual payment).
model Retreat {
  id          String        @id @default(cuid())
  kind        RetreatKind   @default(RETREAT)
  name        String
  location    String?
  startDate   DateTime
  endDate     DateTime
  description String?
  images      String[]
  capacity    Int?
  price       Float?
  currency    String        @default("INR")
  status      RetreatStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  enquiries RetreatEnquiry[]

  @@index([status, kind])
}

model RetreatEnquiry {
  id                String               @id @default(cuid())
  retreatId         String
  retreat           Retreat              @relation(fields: [retreatId], references: [id], onDelete: Cascade)
  name              String
  email             String
  phone             String?
  message           String?
  participantsCount Int                  @default(1)
  status            RetreatEnquiryStatus @default(NEW)
  createdAt         DateTime             @default(now())

  @@index([retreatId])
  @@index([status])
}

enum SupportConversationStatus {
  OPEN
  CLOSED
}

/// A member's support conversation thread. Any staff member can reply (no
/// manual assignment); `assignedToId` is a soft claim set to whoever replies
/// first, for the admin queue's "who's handling this" display only.
model SupportConversation {
  id            String                    @id @default(cuid())
  userId        String
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String?
  status        SupportConversationStatus @default(OPEN)
  assignedToId  String?
  assignedTo    User?                     @relation("SupportAssignee", fields: [assignedToId], references: [id])
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessageAt DateTime                  @default(now())

  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation(fields: [senderId], references: [id])
  senderRole     String // "member" | "staff"
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

/// A numbered tax invoice for a payment. Generated on a successful payment and
/// stored as a PDF in object storage (pdfKey).
model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique // sequential, e.g. "SYK/2026/00042"
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId      String? // Payment.id when it came from a real payment
  subscriptionId String?
  amountInr      Float // despite the name, holds the amount in `currency` — not always INR (NRI/USD checkouts)
  currency       String        @default("INR") // ISO code the amounts above are actually denominated in
  taxInr         Float         @default(0) // GST component, if any
  status         InvoiceStatus @default(ISSUED)
  pdfKey         String? // /api/media/<key>
  notes          String?
  issuedAt       DateTime      @default(now())

  @@index([userId])
  @@index([issuedAt])
}

/// A point-in-time therapy progress reading, entered by a therapist/admin.
/// Scores are 0-10 (higher = worse for pain/stress, better for mobility/sleep —
/// UI labels each). Feeds the member's "Therapy Journey" charts.
model TherapyMeasurement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt        DateTime @default(now())
  painScore      Int?
  mobilityScore  Int?
  sleepScore     Int?
  stressScore    Int?
  weightKg       Float?
  note           String?
  recordedById   String?
  recordedBy     User?    @relation("MeasurementRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([userId, takenAt])
}

enum PatientUpdateStatus {
  PENDING
  REVIEWED
}

/// A between-sessions update a therapy member submits (symptom change, question).
/// Lands in the therapist's review queue.
model PatientUpdate {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  body          String
  attachmentKey String?
  status        PatientUpdateStatus @default(PENDING)
  reviewNote    String?
  reviewedById  String?
  reviewedBy    User?               @relation("PatientUpdateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

/// One admin-initiated push broadcast — an audit/history record of what went out.
model BroadcastLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  title      String
  body       String
  url        String?
  segment    String // "all" | "everyday" | "therapy" | ...
  channelId  String   @default("default")
  recipients Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
