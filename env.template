# Copy to .env (or .env.local for local dev) and fill in real values.

# --- Database ---
DATABASE_URL="postgresql://shaktiyoga:changeme@localhost:5432/shaktiyoga?schema=public"

# --- Auth (REQUIRED) ---
# The app throws on startup if JWT_SECRET is missing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- MinIO / S3 storage ---
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="shakti-yoga-assets"

# --- Next.js ---
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="http://your-domain.com"

# --- Class scheduling ---
# Shared secret for the /api/cron/ensure-instances endpoint (materialises upcoming
# class occurrences). Only needed if you trigger it over HTTP instead of the
# scripts/ensure-instances.ts cron job.
CRON_SECRET=""

# --- Payments (Razorpay) ---
# Required for paid checkout. Keys from https://dashboard.razorpay.com > Settings > API Keys.
# Without these, /api/checkout/subscribe returns 503 for paid plans (the free trial still works).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Mobile IAP (RevenueCat) ---
# The Authorization-header value configured in RevenueCat > Project settings >
# Integrations > Webhooks. Unset = POST /api/webhooks/revenuecat returns 503.
REVENUECAT_WEBHOOK_SECRET=""

# --- Email (Resend) ---
# Transactional email (contact-form alerts, booking + payment confirmations).
# Unset RESEND_API_KEY = emails are logged to the console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Shakti Yoga <onboarding@resend.dev>"
ADMIN_EMAIL=""

# --- AI "yoga guide" assistant (optional) ---
# Unset = the assistant feature self-disables. src/lib/assistant.ts
ANTHROPIC_API_KEY=""

# --- Mobile push receipts (optional) ---
# Expo push receipt auth. Push notifications work without it. src/lib/push.ts
EXPO_ACCESS_TOKEN=""

# --- Analytics (optional) ---
# Unset = analytics events are no-ops. src/lib/posthog.ts
POSTHOG_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# --- GeoIP (optional) ---
# Path to a local MaxMind .mmdb file used for pricing-region detection when no
# geo header is present. Unset = falls back to IN. src/lib/geoip.ts
GEOIP_DB_PATH=""

# --- Mobile deep linking (Universal Links / App Links) ---
# Served from src/app/.well-known/assetlinks.json and apple-app-site-association.
ANDROID_PACKAGE="com.shaktiyoga.app"
ANDROID_SHA256_CERT_FINGERPRINTS=""
APPLE_APP_ID=""
APPLE_TEAM_ID=""
IOS_BUNDLE_ID="com.shaktiyoga.app"

# --- Seeding (see SEED_CREDENTIALS.md) ---
# Password for seeded demo accounts. If unset, the seed generates & prints a random one.
# Note: the dev-only Quick Login buttons on /login always assume the fixed default
# "Password123!" - they stop matching if you set this to something else, by design
# (we don't mirror it into a NEXT_PUBLIC_* var, which would ship it to every browser).
SEED_PASSWORD=""
# Must be "true" to allow `npm run db:seed` when NODE_ENV=production.
ALLOW_PROD_SEED="false"

# --- Docker Compose (read by docker-compose.yml) ---
POSTGRES_USER=shaktiyoga
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shaktiyoga
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
