# Copy to .env (or .env.local for local dev) and fill in real values.

# --- Database ---
DATABASE_URL="postgresql://shaktiyoga:changeme@localhost:5432/shaktiyoga?schema=public"

# --- Auth (REQUIRED) ---
# The app throws on startup if JWT_SECRET is missing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- MinIO / S3 storage ---
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="shakti-yoga-assets"

# --- Next.js ---
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="http://your-domain.com"

# --- Live video (Daily.co) ---
# Required for creating/joining live classes. Leave blank to disable that feature.
DAILY_API_KEY=""

# --- Payments ---
# No provider is wired up yet. While NODE_ENV != production (or ALLOW_MOCK_CHECKOUT=true)
# paid checkouts are granted without a charge. In production without a provider they are
# refused. See src/lib/payments.ts.
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
ALLOW_MOCK_CHECKOUT="false"
PAYMENT_PROVIDER=""
PAYMENT_API_KEY=""

# --- Seeding (see SEED_CREDENTIALS.md) ---
# Password for seeded demo accounts. If unset, the seed generates & prints a random one.
SEED_PASSWORD=""
# Mirror of SEED_PASSWORD exposed to the dev-only Quick Login buttons on /login.
NEXT_PUBLIC_SEED_PASSWORD=""
# Must be "true" to allow `npm run db:seed` when NODE_ENV=production.
ALLOW_PROD_SEED="false"

# --- Docker Compose (read by docker-compose.yml) ---
POSTGRES_USER=shaktiyoga
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shaktiyoga
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
